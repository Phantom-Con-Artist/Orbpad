<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Orbpad.Markdown.MarkdownPreviewWindow"
        Title="Markdown Preview"
        Width="900"
        Height="700"
        MinWidth="500"
        MinHeight="400"
        Background="{DynamicResource OrbpadBackgroundBrush}">

    <DockPanel>

        <!-- ========================= -->
        <!-- Header                     -->
        <!-- ========================= -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource OrbpadSurfaceBrush}"
                BorderBrush="{DynamicResource OrbpadBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">

            <TextBlock Text="Markdown Preview"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OrbpadTextBrush}"/>

        </Border>


        <!-- ========================= -->
        <!-- Markdown Preview           -->
        <!-- ========================= -->

        <NativeWebView x:Name="PreviewWebView"/>

    </DockPanel>

</Window>