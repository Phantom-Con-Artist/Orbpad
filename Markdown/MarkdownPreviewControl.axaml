<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orbpad.Markdown.MarkdownPreviewControl"
             Background="{DynamicResource OrbpadBackgroundBrush}">

    <Border Background="{DynamicResource OrbpadBackgroundBrush}">

        <NativeWebView x:Name="PreviewWebView"
                       Focusable="False"/>

    </Border>

</UserControl>