<UserControl
    x:Class="Orbpad.Orbis.Views.LoreEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orbpad.Orbis.ViewModels"
    mc:Ignorable="d"
    x:DataType="vm:LoreEditorViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700">

    <Grid
        RowDefinitions="Auto,*"
        Background="{DynamicResource OrbpadBackgroundBrush}">

        <!-- ============================================================
             HEADER
             ============================================================ -->

        <Border
            Grid.Row="0"
            Padding="24,18"
            BorderBrush="{DynamicResource OrbpadBorderBrush}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource OrbpadSurfaceBrush}">

            <Grid
                ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    Spacing="4">

                    <TextBlock
                        Text="{Binding Title}"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="{Binding Subtitle}"
                        FontSize="12"
                        Opacity="0.55" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

                    <Button
                        Content="Save"
                        Padding="16,8"
                        Click="Save_Click" />

                    <Button
                        Content="Save As"
                        Padding="16,8"
                        Click="SaveAs_Click" />

                    <Button
                        Content="View Graph"
                        Padding="16,8"
                        Click="ViewGraph_Click" />

                    <Button
                        Content="Close"
                        Padding="16,8"
                        Click="Close_Click" />

                </StackPanel>

            </Grid>

        </Border>


        <!-- ============================================================
             MAIN CONTENT
             ============================================================ -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="1">

            <!-- ========================================================
                 ENTITIES
                 ======================================================== -->

            <Border
                Grid.Column="0"
                Padding="24"
                BorderBrush="{DynamicResource OrbpadBorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource OrbpadBackgroundBrush}">

                <Grid
                    RowDefinitions="Auto,*"
                    RowSpacing="12">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto">

                        <StackPanel
                            Grid.Column="0">

                            <TextBlock
                                Text="Entities"
                                FontSize="16"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding EntityCountText}"
                                FontSize="12"
                                Opacity="0.55" />

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="+ Add Existing"
                            Padding="12,7"
                            Click="AddExistingEntity_Click" />

                    </Grid>


                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Entities}"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListBox.ItemTemplate>

                            <DataTemplate
                                x:DataType="vm:LoreEntityViewModel">

                                <Border
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    Background="{DynamicResource OrbpadSurfaceBrush}">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="0"
                                            Grid.Row="1"
                                            Text="{Binding Type}"
                                            FontSize="11"
                                            Opacity="0.55"
                                            Margin="0,2,0,0" />

                                        <Button
                                            Grid.Column="1"
                                            Grid.RowSpan="2"
                                            Content="×"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="RemoveEntity_Click" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>




                </Grid>

            </Border>


            <!-- ========================================================
                 RELATIONSHIPS
                 ======================================================== -->
            <Border
                Grid.Column="1"
                Padding="24"
                Background="{DynamicResource OrbpadBackgroundBrush}">

                <Grid
                    RowDefinitions="Auto,*,Auto"
                    RowSpacing="12">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto">

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Relationships" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RelationshipCountText}" FontSize="12" Opacity="0.55" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="+ Add Relationship"
                            Padding="12,7"
                            Click="AddRelationshipAndEdit_Click" />
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Relationships}"
                        SelectedItem="{Binding SelectedRelationship, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LoreRelationshipViewModel">
                                <Border
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    Background="{DynamicResource OrbpadSurfaceBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Content="Edit"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="EditRelationship_Click" />

                                        <Button
                                            Grid.Column="2"
                                            Content="Remove"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="RemoveRelationshipAndClose_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Grid.Row="2"
                        Padding="14"
                        CornerRadius="8"
                        Background="{DynamicResource OrbpadSurfaceBrush}"
                        BorderBrush="{DynamicResource OrbpadBorderBrush}"
                        BorderThickness="1"
                        x:Name="RelationshipEditorPanel"
                        IsVisible="False">

                        <StackPanel Spacing="10">
                            <TextBlock Text="Edit Relationship" FontSize="13" FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="*,Auto,1.25*,Auto,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="From" FontSize="11" Opacity="0.55" />
                                    <ComboBox
                                        ItemsSource="{Binding Entities}"
                                        SelectedValue="{Binding SelectedRelationship.SourceId, Mode=TwoWay}"
                                        SelectedValueBinding="{Binding Id}"
                                        PlaceholderText="Source">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LoreEntityViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="→" FontSize="16" Opacity="0.55" VerticalAlignment="Bottom" Margin="0,0,0,7" />

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Relationship" FontSize="11" Opacity="0.55" />
                                    <TextBox
                                        Text="{Binding SelectedRelationship.Type, Mode=TwoWay}"
                                        PlaceholderText="e.g. husband_of" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="→" FontSize="16" Opacity="0.55" VerticalAlignment="Bottom" Margin="0,0,0,7" />

                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="To" FontSize="11" Opacity="0.55" />
                                    <ComboBox
                                        ItemsSource="{Binding Entities}"
                                        SelectedValue="{Binding SelectedRelationship.TargetId, Mode=TwoWay}"
                                        SelectedValueBinding="{Binding Id}"
                                        PlaceholderText="Target">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LoreEntityViewModel">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Button
                                Content="Done"
                                Padding="14,6"
                                HorizontalAlignment="Right"
                                Click="CloseRelationshipEditor_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>