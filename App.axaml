<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orbpad.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>

        <FluentTheme />

        <!-- AvaloniaEdit styles -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />


        <!-- ========================= -->
        <!-- Window                      -->
        <!-- ========================= -->

        <Style Selector="Window">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="FontFamily"
                    Value="Inter"/>
        </Style>


        <!-- ========================= -->
        <!-- Menu                       -->
        <!-- ========================= -->

        <Style Selector="Menu">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="CornerRadius"
                    Value="6"/>

            <Setter Property="Padding"
                    Value="10,6"/>

            <Setter Property="Transitions">
                <Transitions>

                    <BrushTransition Property="Background"
                                      Duration="0:0:0.12"/>

                </Transitions>
            </Setter>
        </Style>

        <Style Selector="MenuItem:pointerover">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceHoverBrush}"/>

        </Style>


        <!-- ========================= -->
        <!-- Buttons                    -->
        <!-- ========================= -->

        <Style Selector="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Transitions">
                <Transitions>

                    <BrushTransition Property="Background"
                                      Duration="0:0:0.12"/>

                    <TransformOperationsTransition
                        Property="RenderTransform"
                        Duration="0:0:0.08"/>

                </Transitions>
            </Setter>

        </Style>

        <Style Selector="Button:pointerover">

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceHoverBrush}"/>

        </Style>

        <Style Selector="Button:pressed">

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadAccentBrush}"/>

            <Setter Property="RenderTransform"
                    Value="scale(0.97)"/>

        </Style>

        <Style Selector="Button:disabled">

            <Setter Property="Opacity"
                    Value="0.45"/>

        </Style>


        <!-- ========================= -->
        <!-- TextBox                    -->
        <!-- ========================= -->

        <Style Selector="TextBox">

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="CaretBrush"
                    Value="{DynamicResource OrbpadAccentBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="{DynamicResource OrbpadAccentMutedBrush}"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">

            <Setter Property="BorderBrush"
                    Value="{DynamicResource OrbpadAccentBrush}"/>

        </Style>


        <!-- ========================= -->
        <!-- Text                       -->
        <!-- ========================= -->

        <Style Selector="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadMutedTextBrush}"/>

        </Style>

    </Application.Styles>


    <!-- ============================= -->
    <!-- Orbpad Theme Resources        -->
    <!-- ============================= -->

    <Application.Resources>

        <!-- Main -->

        <SolidColorBrush x:Key="OrbpadBackgroundBrush"
                         Color="#121214"/>

        <SolidColorBrush x:Key="OrbpadSurfaceBrush"
                         Color="#19191C"/>

        <SolidColorBrush x:Key="OrbpadSurfaceHoverBrush"
                         Color="#25252B"/>

        <SolidColorBrush x:Key="OrbpadBorderBrush"
                         Color="#303036"/>


        <!-- Text -->

        <SolidColorBrush x:Key="OrbpadTextBrush"
                         Color="#F4F4F5"/>

        <SolidColorBrush x:Key="OrbpadMutedTextBrush"
                         Color="#A1A1AA"/>


        <!-- Accent -->

        <SolidColorBrush x:Key="OrbpadAccentBrush"
                         Color="#8B5CF6"/>

        <SolidColorBrush x:Key="OrbpadAccentMutedBrush"
                         Color="#8B5CF6"
                         Opacity="0.30"/>

    </Application.Resources>

</Application>