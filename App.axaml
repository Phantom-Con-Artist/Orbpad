<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orbpad.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>

        <FluentTheme />

        <!-- Orbpad Global Styles -->

        <Style Selector="Window">
            <Setter Property="Background"
                    Value="#121214"/>
            <Setter Property="Foreground"
                    Value="#F4F4F5"/>
        </Style>

        <Style Selector="Menu">
            <Setter Property="Background"
                    Value="#19191C"/>
            <Setter Property="Foreground"
                    Value="#F4F4F5"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background"
                    Value="#121214"/>
            <Setter Property="Foreground"
                    Value="#F4F4F5"/>
            <Setter Property="FontFamily"
                    Value="Inter"/>
            <Setter Property="FontSize"
                    Value="16"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground"
                    Value="#A1A1AA"/>
        </Style>

    </Application.Styles>

    <Application.Resources>

        <!-- Orbpad Resources -->

        <SolidColorBrush x:Key="OrbpadBackgroundBrush"
                         Color="#121214"/>

        <SolidColorBrush x:Key="OrbpadSurfaceBrush"
                         Color="#19191C"/>

        <SolidColorBrush x:Key="OrbpadSurfaceHoverBrush"
                         Color="#252529"/>

        <SolidColorBrush x:Key="OrbpadBorderBrush"
                         Color="#303036"/>

        <SolidColorBrush x:Key="OrbpadTextBrush"
                         Color="#F4F4F5"/>

        <SolidColorBrush x:Key="OrbpadMutedTextBrush"
                         Color="#A1A1AA"/>

        <SolidColorBrush x:Key="OrbpadAccentBrush"
                         Color="#8B5CF6"/>

    </Application.Resources>

</Application>