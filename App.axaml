<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Orbpad.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>

        <FluentTheme />

        <!-- ========================= -->
        <!-- Window                      -->
        <!-- ========================= -->

        <Style Selector="Window">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>
        </Style>


        <!-- ========================= -->
        <!-- Menu                       -->
        <!-- ========================= -->

        <Style Selector="Menu">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>
        </Style>


        <!-- ========================= -->
        <!-- Buttons                    -->
        <!-- ========================= -->

        <Style Selector="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceBrush}"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadSurfaceHoverBrush}"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadAccentBrush}"/>
        </Style>


        <!-- ========================= -->
        <!-- Editor                     -->
        <!-- ========================= -->

        <Style Selector="TextBox">
            <Setter Property="Background"
                    Value="{DynamicResource OrbpadBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadTextBrush}"/>

            <Setter Property="FontFamily"
                    Value="Inter"/>

            <Setter Property="FontSize"
                    Value="16"/>
        </Style>


        <!-- ========================= -->
        <!-- Text                       -->
        <!-- ========================= -->

        <Style Selector="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource OrbpadMutedTextBrush}"/>
        </Style>

    </Application.Styles>


    <!-- ============================= -->
    <!-- Orbpad Theme Resources        -->
    <!-- ============================= -->

    <Application.Resources>

        <!-- Main -->
        <SolidColorBrush x:Key="OrbpadBackgroundBrush"
                         Color="#121214"/>

        <SolidColorBrush x:Key="OrbpadSurfaceBrush"
                         Color="#19191C"/>

        <SolidColorBrush x:Key="OrbpadSurfaceHoverBrush"
                         Color="#25252B"/>

        <SolidColorBrush x:Key="OrbpadBorderBrush"
                         Color="#303036"/>

        <!-- Text -->
        <SolidColorBrush x:Key="OrbpadTextBrush"
                         Color="#F4F4F5"/>

        <SolidColorBrush x:Key="OrbpadMutedTextBrush"
                         Color="#A1A1AA"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="OrbpadAccentBrush"
                         Color="#8B5CF6"/>

    </Application.Resources>

</Application>