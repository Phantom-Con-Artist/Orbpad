<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Orbpad.MainWindow"
        Title="Orbpad"
        Width="1000"
        Height="700"
        MinWidth="600"
        MinHeight="400">

    <TextBox x:Name="Editor"
             AcceptsReturn="True"
             AcceptsTab="True"
             TextWrapping="NoWrap"
             FontSize="16"
             Padding="16"/>

</Window>